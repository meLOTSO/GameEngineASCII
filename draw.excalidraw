      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1H",
      "roundness": null,
      "seed": 678434422,
      "version": 781,
      "versionNonce": 188208182,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791985576746,
      "link": null,
      "locked": false,
      "text": "Приходится создавать 3 экземпляра StateMachine для обработки разных интерфейсов: IUpdateable, IControl, IDrawable.\n\nМетоды решения неудобства:\n1) Можно сперва создать все три объекта, а после добавить их в контейнер какой-нибудь (StateMachineContainer)\n2) Можно сделать один SM главным, и при обновлении состояния в нем обновлять и в других (обработчик состояния)\n\n(1)\n1. Создаем класс Container<T>\n2. В нем содержится список объектов типа T\n3. ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Приходится создавать 3 экземпляра StateMachine для обработки разных интерфейсов: IUpdateable, IControl, IDrawable.\n\nМетоды решения неудобства:\n1) Можно сперва создать все три объекта, а после добавить их в контейнер какой-нибудь (StateMachineContainer)\n2) Можно сделать один SM главным, и при обновлении состояния в нем обновлять и в других (обработчик состояния)\n\n(1)\n1. Создаем класс Container<T>\n2. В нем содержится список объектов типа T\n3. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_z-dRmV3DrFbq1McezQBO",
      "type": "text",
      "x": 1561.2895584106438,
      "y": -658.8802825927735,
      "width": 1530.359619140625,
      "height": 855,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
      "roundness": null,
      "seed": 1560603609,
      "version": 1208,
      "versionNonce": 1333633273,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792067468813,
      "link": null,
      "locked": false,
      "text": "Конфигураторы - ммутируемые сущности, инкапуслируют настройки\nнад определенной сущностью.\n\nКонфигуратор используется в билдере:\npublic class SomeFactory<SomeType, in TBuilder> where TBuilder : IBuilder<SomeType>\n{\n    protected SomeBuilder { get; set; }\n\n    public SomeBuilder(Action<SomeBuilder> builder)\n        => configuration.Invoke(SomeBuilder);\n\n    public SomeType Build() => SomeBuilder.Build();\n}\n\nБилдер:\npublic interface IBuilder<SomeType>\n{\n    public SomeType Build();\n}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Конфигураторы - ммутируемые сущности, инкапуслируют настройки\nнад определенной сущностью.\n\nКонфигуратор используется в билдере:\npublic class SomeFactory<SomeType, in TBuilder> where TBuilder : IBuilder<SomeType>\n{\n    protected SomeBuilder { get; set; }\n\n    public SomeBuilder(Action<SomeBuilder> builder)\n        => configuration.Invoke(SomeBuilder);\n\n    public SomeType Build() => SomeBuilder.Build();\n}\n\nБилдер:\npublic interface IBuilder<SomeType>\n{\n    public SomeType Build();\n}",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
