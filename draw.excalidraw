    {
      "id": "Vkt3FXGJ2STOXeOXJIVOr",
      "type": "text",
      "x": 2556.321446821981,
      "y": 3045.86825094106,
      "width": 2132.963623046875,
      "height": 450,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "transparent",
